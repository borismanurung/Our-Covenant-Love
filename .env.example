# Database Connection
# Default for zero-friction local development is SQLite.
# For production PostgreSQL, set:
# DATABASE_URL="postgresql://user:password@localhost:5432/our_covenant_love?schema=public"
DATABASE_URL="file:./dev.db"

# Application Base URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Authentication Secrets
# Generate random 32+ character string in production
AUTH_SECRET="dev-insecure-covenant-love-secret-key-change-in-production-min32"
SESSION_COOKIE_NAME="ocl_session"

# ==========================================
# SMTP Email Notifications (Gmail / Webmail)
# ==========================================
# To use Gmail: Generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="ourcovenantlove@gmail.com"
SMTP_PASS="your-16-character-app-password"
MAIL_TO="ourcovenantlove@gmail.com"
CONTACT_NOTIFICATION_EMAIL="ourcovenantlove@gmail.com"

# ==========================================
# Google Sheets Real-time Sync (Webhook)
# ==========================================
# Deploy a Google Apps Script web app on your Google Sheet and paste the URL here.
# New submissions will automatically append as new rows in real-time.
GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"
